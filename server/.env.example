# Runtime connection: runtime_role (no DDL, no BYPASSRLS, narrow grants)
DATABASE_URL=postgres://runtime_role:...@...neon.tech/inkling?sslmode=require
# Migration connection: migrate_role (owns schema; used only by `python -m inkling migrate`)
DATABASE_URL_MIGRATE=postgres://migrate_role:...@...neon.tech/inkling?sslmode=require

PORT=8899
BIND=127.0.0.1
CHAT_TOKENS_FILE=/home/user/.inkling/chat-tokens.json
# {"<user_id>": "<32+ char secret>"}: connector URL is https://<host>/mcp/<secret>
MCP_TOKENS_FILE=/home/user/.inkling/mcp-tokens.json
NTFY_BASE=https://ntfy.sh             # operator alerts only
OPERATOR_NTFY=                        # §11/§13 alerts (dead letters, backup); empty disables
# §11 user pushes go straight to APNs. Empty key file disables the channel
# (every Notify then dead-letters and pages OPERATOR_NTFY).
APNS_KEY_FILE=/home/user/.inkling/apns-AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=LJA3588388
APNS_TOPIC=com.sharduldhande.inkling

# §13.2 backup (any S3-compatible; §19.3). Unset = nightly backup alerts as failed.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_GPG_RECIPIENT=
EXPORT_GIT_DIR=/home/user/inkling-data
RESTORE_DRILL_URL=                    # scratch Neon branch (§13.3); empty skips the drill

FEATURE_EMBEDDINGS=false
# §12 calendar (read-only ICS feeds; absent for users with no feed file)
CALENDAR_CONFIG_DIR=~/.inkling        # holds calendars-<user>.json (see ops/RUNBOOK.md)
LOG_LEVEL=info
LOG_FORMAT=json                       # json for journald (§15); plain for dev

# Tests only: must point at a dedicated Neon TEST branch — the harness refuses
# to run unless the URL contains "test" (branch endpoint or database name),
# because the suite DROPS AND RECREATES the public schema on every run.
# TEST_DATABASE_URL=postgres://migrate_role:...@ep-...-test-....neon.tech/inkling_test?sslmode=require
